<mujoco model="3DOF">
    <option timestep="0.001" gravity="0 0 -9.81" cone="elliptic">
        <flag energy="enable" />
    </option>
    <compiler angle="radian" />

    <visual>
        <headlight ambient="0.4 0.4 0.4" diffuse="0.4 0.4 0.4" specular="0.0 0.0 0.0" active="1" />
    </visual>

    <asset>
        <texture builtin="checker" height="512" name="texplane" rgb1=".2 .3 .4" rgb2=".1 .15 .2" type="2d" width="512" />
        <material name="MatPlane" reflectance="0.5" shininess="0.01" specular="0.1" texrepeat="1 1" texture="texplane" texuniform="true" />
    </asset>

    <worldbody>
        <light pos="0 0 1000" castshadow="false" />
        <camera name="cam1" pos="0 -2 1" xyaxes="1 0 0 0 0.5 1" />
        <geom name="ground_plane" type="plane" size="5 5 10" material="MatPlane" rgba="1 1 1 1"/>

        <body name="base_link">
            <geom type="capsule" fromto="0 0 1  0 0 0.6" size="0.06"/>
            <joint name="balljoint" type="ball" pos="0 0 1"/>
            <body name="middle_link">
                <geom type="capsule" fromto="0 0 0.6  0.0 0 0.3" size="0.04"/>
                <joint name="joint1" type="hinge" pos="0 0 0.6" axis="0 1 0"/>
                <!-- <joint name="joint2" type="hinge" pos="0 0 0.6" axis="1 0 0"/> -->
                <body name="end_link">
                    <geom name="EE" type="capsule" fromto="0 0 0.3  0.0 0 0.1" size="0.02"/>
                    <joint name="joint2" type="hinge" pos="0.0 0 0.3" axis="0 1 0"/>
                    <site name="joint2_site" pos="0 0 0" rgba="1 0 0 1" size="0.001" />
                </body>
            </body>
        </body>
        <body name="body_ball" pos="1 0 0.06" >
            <freejoint name="ball_freejoint"/>
            <geom name="ball" type="sphere" size="0.05" rgba="1.0 0.55 0.0 0.2" mass="0.1"/>
        </body>
        <body name="immovable" pos="0.56428 0.221972 0.6">
            <geom type="box" size=".0125 .016 .032" rgba=".5 .5 .5 1" />
            <inertial pos="0 0 0" mass="0.1024" diaginertia="4.369e-5 4.028e-5 1.407e-5"/>
        </body>
    </worldbody>

    <tendon>
        <fixed name="tendon1">
            <joint joint="joint1" coef="1" />
            <joint joint="joint2" coef="1" />
        </fixed>
    </tendon>

    <actuator>
        <motor name="tendon_motor" tendon="tendon1" />
    </actuator>

    <sensor>
        <framepos   name="immovable_pos"  objtype="xbody" objname="immovable" />
        <framequat  name="immovable_quat" objtype="xbody" objname="immovable" />
        <framexaxis name="framex_EE"      objtype="site"  objname="joint2_site" />

        <velocimeter name="vel_EE" site="joint2_site" />
        <jointvel    name="vel_joint2"  joint="joint2" />

        <subtreecom  name="subtree_end_link" body="end_link" />

        <frameangvel name="angvel_world" objtype="xbody" objname="end_link" />
        <frameangvel name="angvel_ref"   objtype="xbody" objname="end_link" reftype="xbody" refname="base_link" />
        <tendonactuatorfrc name="tendon_act_frc" tendon="tendon1" />
        <e_potential name="energy_pot" />
        <e_kinetic   name="energy_kin" />
        <insidesite  name="inside_ball" site="joint2_site" objtype="xbody" objname="body_ball" />
        <distance    name="geom_dist"   geom1="EE" geom2="ball" cutoff="10" />
        <normal      name="geom_normal" geom1="EE" geom2="ball" cutoff="10" />
        <fromto      name="geom_fromto" geom1="EE" geom2="ball" cutoff="10" />
        <camprojection name="cam_proj" site="joint2_site" camera="cam1" />
    </sensor>
</mujoco>
