<mujoco model="compound_world">
    <option timestep="0.001" gravity="0 0 -9.81" />
    <compiler angle="radian" />

    <worldbody>
        <geom name="ground_plane" type="plane" size="5 5 10" />
        <!-- Tilted off the hanging pose so gravity gives every force/velocity/acceleration part a nonzero value -->
        <body name="link_a" pos="0 0 1" euler="0 0.4 0">
            <geom type="capsule" fromto="0 0 0  0 0 -0.3" size="0.04" />
            <joint name="hinge_a" type="hinge" axis="0 1 0" />
            <site name="site_a" size="0.001" />
            <!-- Off the hinge axis, so its linear velocity/acceleration is nonzero -->
            <site name="site_tip" pos="0 0 -0.3" size="0.001" />
            <body name="link_b" pos="0 0 -0.3">
                <geom type="capsule" fromto="0 0 0  0 0 -0.3" size="0.03" />
                <joint name="ball_b" type="ball" />
                <site name="site_b" size="0.001" />
            </body>
        </body>
        <!-- World-parented ball joint: the only ballquat that is a world-frame orientation (IMU ballquat case) -->
        <body name="link_c" pos="1 0 1" euler="0 0.4 0">
            <geom type="capsule" fromto="0 0 0  0 0 -0.3" size="0.03" />
            <joint name="ball_c" type="ball" />
            <site name="site_c" size="0.001" />
        </body>
    </worldbody>

    <sensor>
        <!-- link_a: sensors with frame_id link_a. MuJoCo has no ref frame for framelinacc/frameangacc, and the
             native plugin leaves their frame_id at world, so an Accel pair always shares one frame. -->
        <accelerometer name="acc_a"     site="site_a" />
        <gyro          name="gyro_a"    site="site_a" />
        <force         name="force_a"   site="site_a" />
        <torque        name="torque_a"  site="site_a" />
        <framequat     name="quat_a"    objtype="xbody" objname="link_a" />
        <framequat     name="imu_quat_a" objtype="xbody" objname="link_a" />
        <framepos      name="pos_a"     objtype="xbody" objname="link_a" />
        <framelinvel   name="linvel_a"  objtype="site" objname="site_a" reftype="body" refname="link_a" />
        <frameangvel   name="angvel_a"  objtype="site" objname="site_a" reftype="body" refname="link_a" />
        <framelinacc   name="linacc_a"  objtype="site" objname="site_a" />
        <frameangacc   name="angacc_a"  objtype="site" objname="site_a" />

        <!-- link_b: other body, so other frame_id and other orientation identity -->
        <accelerometer name="acc_b"      site="site_b" />
        <gyro          name="gyro_b"     site="site_b" />
        <torque        name="torque_b"   site="site_b" />
        <framequat     name="quat_b"     objtype="xbody" objname="link_b" />
        <ballquat      name="ballquat_b" joint="ball_b" />
        <!-- link_b position expressed in link_a: pairs with quat_b (same body) for a Pose with frame_id link_a -->
        <framepos      name="pos_b_in_a" objtype="xbody" objname="link_b" reftype="body" refname="link_a" />
        <!-- same body and reference as pos_b_in_a, so they form a valid Pose/Odometry pair -->
        <framequat     name="quat_b_in_a" objtype="xbody" objname="link_b" reftype="body" refname="link_a" />
        <!-- link_b in the world frame: pairs with quat_b -->
        <framepos      name="pos_b"      objtype="xbody" objname="link_b" />
        <!-- link_b motion in world: shares frame_id world with linvel_world/angvel_world but is another body -->
        <framelinvel   name="linvel_b_world" objtype="site" objname="site_b" />
        <frameangvel   name="angvel_b_world" objtype="site" objname="site_b" />
        <!-- link_b angular velocity expressed in link_a: same frame_id as acc_a, other body -->
        <frameangvel   name="angvel_b_in_a" objtype="site" objname="site_b" reftype="body" refname="link_a" />

        <!-- link_c: world-parented ball joint, all sensors on one body -->
        <accelerometer name="acc_c"       site="site_c" />
        <ballangvel    name="ballangvel_c" joint="ball_c" />
        <ballquat      name="ballquat_c" joint="ball_c" />

        <!-- frame_id world, differs from link_a -->
        <frameangvel   name="angvel_world" objtype="site" objname="site_a" />
        <!-- Without a reference frame the velocity is the site's world motion; measured relative to link_a it is 0 -->
        <framelinvel   name="linvel_world" objtype="site" objname="site_tip" />
        <framelinacc   name="linacc_tip"   objtype="site" objname="site_tip" />
    </sensor>
</mujoco>
