<robot name="invalid_effort"><link name="base"/><link name="link"/>
  <joint name="joint_1" type="revolute"><parent link="base"/><child link="link"/><axis xyz="0 0 1"/>
    <limit lower="-1" upper="1" effort="0" velocity="1"/></joint>
  <ros2_control name="system" type="system"><joint name="joint_1"><command_interface name="effort"/></joint></ros2_control>
</robot>
