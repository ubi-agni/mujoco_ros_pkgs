<?xml version="1.0"?>
<robot name="collision_only_robot">
  <mujoco><compiler fusestatic="false"/></mujoco>
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <collision>
      <geometry>
        <mesh filename="../mesh_robot/meshes/collision/Link0_body_convex_hull.obj"/>
      </geometry>
    </collision>
  </link>
</robot>
