<?xml version="1.0"?>
<launch>

  <env name="ROSCONSOLE_FORMAT" value="[${severity}] [${time}] [${logger}] [${node}]: ${message}"/>
  <env name="ROSCONSOLE_CONFIG_FILE"
       value="$(find mujoco_ros)/config/rosconsole.config"/>

  <arg name="output_dir" default="@RENDER_PERFORMANCE_OUTPUT_DIR@"/>
  <param name="/use_sim_time" value="true"/>

  <test test-name="$(anon render_performance_@RENDER_PERFORMANCE_CASE@)"
        pkg="mujoco_ros" type="render_performance_test"
        args="--backend @RENDER_PERFORMANCE_BENCHMARK_BACKEND@ --camera-count @RENDER_PERFORMANCE_CAMERA_COUNT@ --iterations @RENDER_PERFORMANCE_ITERATIONS@ --repeat @RENDER_PERFORMANCE_REPEAT@ --output $(arg output_dir)/render_performance_@RENDER_PERFORMANCE_CASE@.json"
        time-limit="@RENDER_PERFORMANCE_TIME_LIMIT@"/>
</launch>
