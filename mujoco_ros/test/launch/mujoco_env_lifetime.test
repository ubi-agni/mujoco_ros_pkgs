<?xml version="1.0"?>
<launch>

  <env name="ROSCONSOLE_FORMAT" value="[${severity}] [${time}] [${logger}] [${node}]: ${message}"/>
  <env name="ROSCONSOLE_CONFIG_FILE"
       value="$(find mujoco_ros)/config/rosconsole.config"/>

  <param name="/use_sim_time" value="true"/>
  <!-- Keep _exit()-based child cases out of the regular gtest result stream. -->
  <test test-name="mujoco_env_lifetime_test"
        pkg="mujoco_ros" type="mujoco_env_test"
        args="--gtest_filter=*Isolated" time-limit="240.0"/>
</launch>
